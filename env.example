# --- Discord ---
DISCORD_TOKEN=
OWNER_IDS=
ALLOWED_GUILD_IDS=

# --- Dashboard ---
ADMIN_PASSWORD=
# Any long random text (keeps you logged in). On Render this is generated for you.
SECRET_KEY=
DISPLAY_TZ=Asia/Manila

# --- Who makes the pictures / videos ---
# Default when a member doesn't pick one:  claude | grok | pollinations
IMAGE_PROVIDER=pollinations
# Default for /video:  claude | grok
VIDEO_PROVIDER=grok

# Pollinations (pictures only). nologo is always sent.
POLLINATIONS_TOKEN=

# Grok / xAI (pictures + video)  ->  https://console.x.ai
XAI_API_KEY=
GROK_IMAGE_MODEL=grok-imagine-image-2.0
GROK_VIDEO_MODEL=grok-imagine-video-1.5

# Claude / Anthropic (pictures + video, drawn as vector art)  ->  https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Limits ---
MIN_INTERVAL_MINUTES=10
# Max creations per member per 24h (0 = unlimited)
DAILY_LIMIT_PER_USER=0

# --- Database (leave empty locally; REQUIRED on Render) ---
DATABASE_URL=
